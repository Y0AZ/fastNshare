# Modèle des variables d'environnement du serveur : copier vers .env (cp .env.example .env) puis adapter.
# Ne contient que des valeurs de développement : les vraies valeurs de production sont saisies chez l'hébergeur.
# Chaque tâche ajoute ici les variables qu'elle introduit (MONGODB_URI en T1.1, S3_* en T1.3, TRUST_PROXY en T2.4, MAINTENANCE_TOKEN en T2.5).

# Port HTTP du serveur (requis).
PORT=4000

# Connexion MongoDB (requis). Valeur ci-dessous = conteneur du docker-compose.yml (port 27018, identifiants de dev).
# authSource=admin : l'utilisateur root du conteneur est enregistré dans la base « admin ».
# En production : la chaîne Atlas (mongodb+srv://…), saisie dans Render.
MONGODB_URI=mongodb://fastshare:fastshare-dev-password@localhost:27018/fastshare?authSource=admin

# Stockage S3 (requis sauf S3_ENDPOINT). Valeurs ci-dessous = SeaweedFS du docker-compose.yml (identifiants de dev).
# En production : celles du fournisseur choisi en T6.2 (R2, S3 ou B2), saisies dans Render.
# S3_ENDPOINT : à laisser vide pour AWS S3 ; obligatoire pour SeaweedFS, R2, B2.
S3_ENDPOINT=http://localhost:8333
# SeaweedFS accepte n'importe quelle région ; AWS exige la vraie (ex. eu-west-3), R2 attend « auto ».
S3_REGION=us-east-1
S3_BUCKET=fastshare
S3_ACCESS_KEY_ID=fastshare-dev-access-key
S3_SECRET_ACCESS_KEY=fastshare-dev-secret-key
# true pour SeaweedFS (URL http://hôte/bucket/clé) ; false par défaut (http://bucket.hôte/clé).
S3_FORCE_PATH_STYLE=true

# Nombre de proxys de confiance devant le serveur (facultatif, 0 par défaut). En local : 0 (aucun proxy).
# Sur Render : 1. Sert à retrouver la vraie IP du client pour le rate limit (X-Forwarded-For).
TRUST_PROXY=0

# Jeton de la route POST /api/maintenance/cleanup (facultatif, 32 caractères minimum).
# Absent ou vide → la route n'existe pas (404). Générer une valeur : openssl rand -hex 32
# En production : saisi dans Render et dans les secrets GitHub (déclenchement planifié, T6.5).
MAINTENANCE_TOKEN=
